{
  "allowedUrls": [
    "https://docs.github.com",
    "https://astral.sh",
    "https://dev.azure.com",
    "https://github.com",
    "https://raw.githubusercontent.com",
    "https://agentskills.io",
    "https://spsprodwus21.vssps.visualstudio.com",
    "https://learn.microsoft.com",
    "https://eng.ms",
    "https://login.microsoftonline.com",
    "https://api.github.com",
    "https://azure.microsoft.com",
    "https://developer.hashicorp.com",
    "https://cli.github.com",
    "https://azure.archive.ubuntu.com",
    "https://index.crates.io",
    "https://docs.docker.com",
    "https://aka.ms",
    "https://files.pythonhosted.org",
    "https://packagefeedproxy.microsoft.io",
    "http://meru-build-cache.guest.corp.microsoft.com:9090"
  ],
  "bashEnv": true,
  "companyAnnouncements": [
    "Need help with Agency? In a local Agency session, use `/agency:agency-support`; otherwise run `agency support` or join the support community: https://aka.ms/agency/support"
  ],
  "contextTier": "default",
  "disabledSkills": [],
  "editorMode": "normal",
  "effortLevel": "high",
  "includeCoAuthoredBy": false,
  "logLevel": "all",
  "model": "gpt-6-luna",
  "planContextTier": "long_context",
  "planEffortLevel": "extra high",
  "planModel": "gpt-6.1-sol",
  "renderMarkdown": true,
  "sandbox": {
    "addCurrentWorkingDirectory": true,
    "allowBypass": true,
    "allowDevToolAccess": true,
    "auth": {
      "gh": true,
      "git": true
    },
    "enabled": false,
    "sandboxLspServers": true,
    "sandboxMcpServers": true,
    "userPolicy": {
      "filesystem": {
        "deniedPaths": [],
        "readonlyPaths": [
          "/var/crash",
          "/opt/az"
        ],
        "readwritePaths": [
          "/home/thkawcha",
          "/home/merutest",
          "/home/thkawcha/tmp",
          "/home/merutest/tmp",
          "/home/thkawcha/tmp/copilot-uv-cache",
          "/home/merutest/tmp/copilot-uv-cache",
          "/tmp",
          "/home/thkawcha/latest-release-packages",
          "/home/merutest/latest-release-packages",
          "/home/thkawcha/meru*",
          "/home/merutest/meru*",
          "/home/meruuser",
          "/mnt/merudataroot",
          "/mnt/meru-artifacts",
          "/home/thkawcha/.cache",
          "/home/merutest/.cache",
          "/home/thkawcha/.azure",
          "/home/thkawcha/.cache/uv",
          "/home/merutest/.cache/uv",
          "/home/merutest/.azure",
          "/home/thkawcha/.copilot",
          "/home/merutest/.copilot",
          "/var/run/docker.sock",
          "/build/out",
          "/build/src"
        ]
      },
      "network": {
        "allowLocalNetwork": true,
        "allowOutbound": true
      }
    }
  },
  "screenReader": false,
  "showReasoning": true,
  "subagents": {
    "contextManagementTools": false,
    "maxConcurrency": 5,
    "maxDepth": 2
  },
  "theme": "auto",
  "voice": {
    "enabled": false,
    "selectedModel": "nemotron-3.5-asr-streaming-0.6b-generic-cpu:3"
  },
  "autoUpdatesChannel": "stable"
}
